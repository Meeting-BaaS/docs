{
  "components": {
    "schemas": {
      "BotCredentials": {
        "additionalProperties": false,
        "description": "Bring-your-own provider keys for one bot.\n\nEvery field is optional; a key that is not supplied falls back to the\nserver's own configuration. Keys are handed to this bot's pipeline process\nonly, are never written to disk or logs, and are never returned by the API.",
        "properties": {
          "llm_api_key": {
            "anyOf": [
              {
                "format": "password",
                "minLength": 1,
                "type": "string",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "description": "API key for the LLM provider selected by llm_provider (OpenAI, Anthropic or Z.ai).",
            "format": "password",
            "title": "Llm Api Key",
            "writeOnly": true
          },
          "stt_api_key": {
            "anyOf": [
              {
                "format": "password",
                "minLength": 1,
                "type": "string",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "description": "Deepgram API key for speech-to-text.",
            "format": "password",
            "title": "Stt Api Key",
            "writeOnly": true
          },
          "tts_api_key": {
            "anyOf": [
              {
                "format": "password",
                "minLength": 1,
                "type": "string",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "description": "Cartesia API key for text-to-speech.",
            "format": "password",
            "title": "Tts Api Key",
            "writeOnly": true
          }
        },
        "title": "BotCredentials",
        "type": "object"
      },
      "BotRequest": {
        "additionalProperties": false,
        "description": "Request model for creating a speaking bot in a meeting.",
        "example": {
          "bot_image": "https://example.com/bot-avatar.png",
          "bot_name": "Meeting Assistant",
          "enable_tools": true,
          "entry_message": "Hello! I'm here to assist with the meeting.",
          "extra": {
            "company": "ACME Corp",
            "meeting_purpose": "Weekly sync"
          },
          "llm_model": "claude-opus-4-8",
          "llm_provider": "anthropic",
          "mcp": {
            "servers": [
              {
                "name": "crm",
                "tool_allowlist": [
                  "get_account",
                  "list_recent_calls"
                ],
                "tools": [
                  "get_account",
                  "list_recent_calls"
                ],
                "transport": "streamable_http",
                "url": "https://mcp.example.com"
              }
            ]
          },
          "mcp_profile": "professional",
          "mcp_profile_tool_access": "read_only",
          "meeting_url": "https://meet.google.com/abc-defg-hij",
          "personas": [
            "helpful_assistant",
            "meeting_facilitator"
          ],
          "prompt": "You are Meeting Assistant, a concise and professional                 AI bot that helps summarize key points and keep the meeting on track. Speak clearly and stay on topic.",
          "prompt_data_sources": [
            {
              "name": "CRM account notes",
              "type": "url",
              "url": "https://example.com/account-notes.md"
            }
          ],
          "prompt_data_token_limit": 3000,
          "speech_speed": 1.15,
          "websocket_url": "wss://bots.example.com"
        },
        "properties": {
          "bot_image": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bot Image"
          },
          "bot_name": {
            "default": "",
            "description": "Name to display for the bot in the meeting",
            "title": "Bot Name",
            "type": "string"
          },
          "credentials": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BotCredentials"
              },
              {
                "type": "null"
              }
            ],
            "description": "Bring your own provider keys for this bot (LLM, speech-to-text, text-to-speech). Any key left out falls back to the server's own configuration. Keys are used only by this bot's pipeline and are never stored or returned."
          },
          "enable_tools": {
            "default": true,
            "title": "Enable Tools",
            "type": "boolean"
          },
          "entry_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entry Message"
          },
          "extra": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extra"
          },
          "llm_model": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Provider model for this bot. Defaults to provider-specific env vars.",
            "title": "Llm Model"
          },
          "llm_provider": {
            "anyOf": [
              {
                "enum": [
                  "openai",
                  "anthropic",
                  "zai"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "LLM provider for this bot. Defaults to LLM_PROVIDER, then openai.",
            "title": "Llm Provider"
          },
          "mcp": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MCPConfig"
              },
              {
                "type": "null"
              }
            ],
            "description": "MCP server/tool metadata and optional live connection details"
          },
          "mcp_profile": {
            "anyOf": [
              {
                "enum": [
                  "professional",
                  "personal",
                  "all"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional trusted local mcpproxy group preset. 'professional' connects to MCP_PROXY_PROFESSIONAL_URL or http://127.0.0.1:8111/mcp; 'personal' connects to MCP_PROXY_PERSONAL_URL or http://127.0.0.1:8110/mcp; 'all' connects to MCP_PROXY_ALL_URL or http://127.0.0.1:8109/mcp. The preset is merged with explicit mcp servers when both are supplied.",
            "title": "Mcp Profile"
          },
          "mcp_profile_tool_access": {
            "default": "read_only",
            "description": "Tool exposure for mcp_profile presets. 'read_only' exposes retrieve_tools, call_tool_read, read_cache, and set_profile. 'read_write' also exposes call_tool_write. Presets never expose upstream_servers, call_tool_destructive, code_execution, registry, or quarantine tools.",
            "enum": [
              "read_only",
              "read_write"
            ],
            "title": "Mcp Profile Tool Access",
            "type": "string"
          },
          "meeting_url": {
            "description": "URL of the Google Meet, Zoom or Microsoft Teams meeting to join",
            "title": "Meeting Url",
            "type": "string"
          },
          "personas": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 10,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "List of persona names to use. The first available will be selected.",
            "title": "Personas"
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt"
          },
          "prompt_data_sources": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/PromptDataSource"
                },
                "maxItems": 10,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "External text or URL data sources to append to the bot prompt",
            "title": "Prompt Data Sources"
          },
          "prompt_data_token_limit": {
            "default": 4000,
            "description": "Approximate total token cap for loaded prompt_data_sources. 0 disables loading.",
            "maximum": 50000.0,
            "minimum": 0.0,
            "title": "Prompt Data Token Limit",
            "type": "integer"
          },
          "speech_speed": {
            "anyOf": [
              {
                "maximum": 1.5,
                "minimum": 0.6,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "TTS speaking speed multiplier. Honored range is 0.6-1.5 (the runner clamps to it); values outside are rejected. Defaults to CARTESIA_TTS_SPEED, TTS_SPEED, SPEECH_SPEED, or the runner default.",
            "title": "Speech Speed"
          },
          "transcription_enabled": {
            "default": true,
            "description": "Have MeetingBaas transcribe the recording once the meeting ends, with the bot's own turns attributed to it by name. Set false for a recording without a transcript.",
            "title": "Transcription Enabled",
            "type": "boolean"
          },
          "transcription_provider": {
            "default": "gladia",
            "description": "MeetingBaas speech-to-text provider for that transcript.",
            "enum": [
              "gladia",
              "deepgram",
              "assemblyai",
              "speechmatics",
              "soniox"
            ],
            "title": "Transcription Provider",
            "type": "string"
          },
          "turn_config": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TurnConfig"
              },
              {
                "type": "null"
              }
            ],
            "description": "Per-bot turn-taking tuning (VAD confidence/start_secs/stop_secs/min_volume)"
          },
          "websocket_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional public WebSocket base URL override, e.g. wss://bot.example.com",
            "title": "Websocket Url"
          }
        },
        "required": [
          "meeting_url"
        ],
        "title": "BotRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JoinResponse": {
        "description": "Response model for a bot joining a meeting",
        "properties": {
          "bot_id": {
            "description": "The MeetingBaas bot ID used for API operations with MeetingBaas",
            "title": "Bot Id",
            "type": "string"
          }
        },
        "required": [
          "bot_id"
        ],
        "title": "JoinResponse",
        "type": "object"
      },
      "LeaveBotRequest": {
        "additionalProperties": false,
        "description": "Request model for making a bot leave a meeting",
        "properties": {
          "bot_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The MeetingBaas bot ID to remove from the meeting. This will also close the WebSocket connection made through Pipecat by this bot.",
            "title": "Bot Id"
          }
        },
        "title": "LeaveBotRequest",
        "type": "object"
      },
      "MCPConfig": {
        "additionalProperties": false,
        "description": "Bot-level MCP configuration: the set of servers to expose plus global instructions.",
        "properties": {
          "instructions": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Global MCP usage instructions for the bot",
            "title": "Instructions"
          },
          "servers": {
            "description": "MCP servers to document and optionally connect for tool calls",
            "items": {
              "$ref": "#/components/schemas/MCPServerConfig"
            },
            "maxItems": 10,
            "title": "Servers",
            "type": "array"
          }
        },
        "title": "MCPConfig",
        "type": "object"
      },
      "MCPServerConfig": {
        "additionalProperties": false,
        "description": "MCP server metadata and optional live connection details.",
        "properties": {
          "enabled": {
            "default": true,
            "description": "Whether this server may be used. Disabled servers are documented but not connected.",
            "title": "Enabled",
            "type": "boolean"
          },
          "headers": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional HTTP headers for remote MCP servers. Use only when a server requires them.",
            "title": "Headers"
          },
          "instructions": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Operator instructions or constraints for this MCP server",
            "title": "Instructions"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "timeout_seconds": {
            "anyOf": [
              {
                "maximum": 300.0,
                "minimum": 0.1,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional per-server connection/tool timeout in seconds.",
            "title": "Timeout Seconds"
          },
          "tool_allowlist": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 50,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional allowlist of MCP tool names this bot may call from this server.",
            "title": "Tool Allowlist"
          },
          "tools": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 50,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Known tool names exposed by this MCP server",
            "title": "Tools"
          },
          "transport": {
            "anyOf": [
              {
                "enum": [
                  "http",
                  "streamable_http",
                  "sse"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Remote MCP transport. Omit for metadata-only servers that cannot execute tools.",
            "title": "Transport"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Remote MCP server URL. Required for http, streamable_http, and sse transports.",
            "title": "Url"
          }
        },
        "required": [
          "name"
        ],
        "title": "MCPServerConfig",
        "type": "object"
      },
      "PersonaImageRequest": {
        "properties": {
          "characteristics": {
            "description": "List of specific characteristics or features of the persona",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": {
            "description": "Detailed description of the persona's appearance and characteristics",
            "type": "string"
          },
          "gender": {
            "description": "Gender of the persona (optional)",
            "enum": [
              "male",
              "female",
              "non-binary"
            ],
            "type": "string"
          },
          "name": {
            "description": "Name of the persona to generate an image for",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description"
        ],
        "type": "object"
      },
      "PersonaImageResponse": {
        "properties": {
          "generated_at": {
            "description": "Timestamp when the image was generated",
            "format": "date-time",
            "type": "string"
          },
          "image_url": {
            "description": "URL of the generated image",
            "type": "string"
          },
          "name": {
            "description": "Name of the persona",
            "type": "string"
          }
        },
        "type": "object"
      },
      "PromptDataSource": {
        "additionalProperties": false,
        "description": "External context to append to the bot prompt under a token budget.",
        "properties": {
          "headers": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional HTTP headers for URL sources. Avoid request-specific secrets unless needed.",
            "title": "Headers"
          },
          "name": {
            "default": "external_context",
            "description": "Human-readable source name shown inside the prompt context block",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Inline context. Required when type is text.",
            "title": "Text"
          },
          "token_limit": {
            "anyOf": [
              {
                "maximum": 50000.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional per-source token cap before the request-level cap is applied",
            "title": "Token Limit"
          },
          "type": {
            "description": "Whether to load inline text or fetch an external HTTP(S) URL",
            "enum": [
              "text",
              "url"
            ],
            "title": "Type",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "HTTP(S) URL to fetch. Required when type is url.",
            "title": "Url"
          }
        },
        "required": [
          "type"
        ],
        "title": "PromptDataSource",
        "type": "object"
      },
      "TurnConfig": {
        "additionalProperties": false,
        "description": "Per-bot voice-activity / turn-taking tuning.\n\nAll fields optional; unset fields fall back to the VAD_* env vars, then\npipecat defaults. Human-facing bots want snappy turn-taking (low\nstop_secs); bot-vs-bot meetings want patience (higher stop_secs and\nstart_secs) so the bots stop barging in on each other.",
        "properties": {
          "confidence": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "VAD speech confidence threshold",
            "title": "Confidence"
          },
          "min_volume": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Minimum input volume for VAD",
            "title": "Min Volume"
          },
          "start_secs": {
            "anyOf": [
              {
                "maximum": 5.0,
                "minimum": 0.05,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Sustained speech (seconds) before a turn registers",
            "title": "Start Secs"
          },
          "stop_secs": {
            "anyOf": [
              {
                "maximum": 10.0,
                "minimum": 0.1,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Silence (seconds) before the bot considers the speaker done and replies",
            "title": "Stop Secs"
          }
        },
        "title": "TurnConfig",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "description": "MeetingBaas API key for authentication",
        "in": "header",
        "name": "x-meeting-baas-api-key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "API for deploying AI-powered speaking agents in video meetings. Combines MeetingBaas for meeting connectivity with Pipecat for voice AI processing.",
    "title": "Speaking Meeting Bot API",
    "version": "2026-10-22-v0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/bots": {
      "post": {
        "description": "Create and deploy a speaking bot in a meeting.\n\nLaunches an AI-powered bot that joins a video meeting through MeetingBaas\nand processes audio using Pipecat's voice AI framework.",
        "operationId": "join_meeting_bots_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BotRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinResponse"
                }
              }
            },
            "description": "Bot successfully created and joined the meeting"
          },
          "400": {
            "description": "Bad request - Missing required fields or invalid data"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "description": "Server error - Failed to create bot through MeetingBaas API"
          }
        },
        "summary": "Join Meeting",
        "tags": [
          "bots"
        ]
      }
    },
    "/bots/{bot_id}": {
      "delete": {
        "description": "Remove a bot from a meeting by its ID.\n\nThis will:\n1. Call the MeetingBaas API to make the bot leave\n2. Close WebSocket connections if they exist\n3. Terminate the associated Pipecat process",
        "operationId": "leave_bot_bots__bot_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "bot_id",
            "required": true,
            "schema": {
              "title": "Bot Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeaveBotRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Leave Bot Bots  Bot Id  Delete",
                  "type": "object"
                }
              }
            },
            "description": "Bot successfully removed from meeting"
          },
          "400": {
            "description": "Bad request - Missing required fields or identifiers"
          },
          "404": {
            "description": "Bot not found - No bot with the specified ID"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "description": "Server error - Failed to remove bot from MeetingBaas API"
          }
        },
        "summary": "Leave Bot",
        "tags": [
          "bots"
        ]
      }
    },
    "/personas/generate-image": {
      "post": {
        "description": "Generate an image for a persona using Replicate.",
        "operationId": "generate_persona_image_personas_generate_image_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonaImageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonaImageResponse"
                }
              }
            },
            "description": "Image successfully generated"
          },
          "400": {
            "description": "Invalid request data"
